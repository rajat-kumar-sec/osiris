# ------------------------------------------------------------------
# OSIRIS - environment configuration
# Every variable is OPTIONAL. The platform degrades gracefully and
# keeps working with keyless public feeds.
# ------------------------------------------------------------------

# Global live ship tracking (free key: https://aisstream.io)
# Without it, live vessels come from open Baltic/Nordic feeds.
AISSTREAM_API_KEY=

# NASA FIRMS active fire detections
# Free key: https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_KEY=

# abuse.ch threat intelligence (free: https://auth.abuse.ch)
URLHAUS_AUTH_KEY=
ABUSEIPDB_API_KEY=

# Cloudflare Radar (free API token with Radar read permission)
CLOUDFLARE_RADAR_TOKEN=

# OI assistant (any OpenAI-compatible endpoint)
OI_BASE_URL=https://api.openai.com/v1
OI_API_KEY=
OI_MODEL=gpt-4o-mini

# Shared cache (optional). Falls back to an in-process cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Scanner guardrails
SCAN_MAX_PORTS=512
SCAN_TIMEOUT_MS=1200
SCAN_CONCURRENCY=96
SCAN_RATE_PER_HOUR=20
